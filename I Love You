<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>I Love You</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #08080f;
            color: #ff1744;
            min-height: 100vh;
            overflow: hidden;
            font-family: "Courier New", monospace;
        }

        /* Initial screen */
        .intro {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: 1s ease;
        }

        .system {
            color: #777;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .ready {
            color: #fff;
            font-size: 16px;
            margin-bottom: 25px;
        }

        .message {
            color: #ff1744;
            border: 1px solid #ff1744;
            background: transparent;
            padding: 10px 25px;
            font-family: inherit;
            cursor: pointer;
            transition: 0.3s;
        }

        .message:hover {
            background: #ff1744;
            color: #08080f;
            box-shadow: 0 0 20px #ff1744;
        }

        /* Heart screen */
        .heart-container {
            position: absolute;
            inset: 0;
            display: flex;
            justify-content: center;
            align-items: center;

            opacity: 0;
            visibility: hidden;
            transition: 1s ease;
        }

        .heart {
            position: relative;
            width: 500px;
            height: 450px;
        }

        .love {
            position: absolute;
            color: #ff1744;
            font-size: 12px;
            white-space: nowrap;
            text-shadow: 0 0 8px #ff1744;
            animation: appear 0.8s forwards;
            opacity: 0;
        }

        @keyframes appear {
            from {
                opacity: 0;
                transform: scale(0.3);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .heart-title {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: #ff1744;
            font-size: 25px;
            font-weight: bold;
            text-shadow: 0 0 15px #ff1744;
            opacity: 0;
            animation: titleAppear 2s forwards;
            animation-delay: 2s;
        }

        @keyframes titleAppear {
            to {
                opacity: 1;
            }
        }

        /* Mobile */
        @media (max-width: 600px) {
            .heart {
                width: 350px;
                height: 350px;
            }

            .love {
                font-size: 9px;
            }

            .heart-title {
                font-size: 20px;
            }
        }
    </style>
</head>

<body>

    <!-- Initial screen -->
    <div class="intro" id="intro">

        <div class="system">
            [system] Initializing heart_protocol v2.0...
        </div>

        <div class="ready">
            [status] READY
        </div>

        <button class="message" onclick="openMessage()">
            ♡ DECRYPT MESSAGE
        </button>

    </div>


    <!-- Heart -->
    <div class="heart-container" id="heartContainer">

        <div class="heart" id="heart">
            <div class="heart-title">
                I LOVE YOU
            </div>
        </div>

    </div>


    <script>

        function openMessage() {

            // Hide intro
            document.getElementById("intro").style.opacity = "0";

            setTimeout(() => {

                document.getElementById("intro").style.visibility = "hidden";

                // Show heart
                const container =
                    document.
                    getElementById("heartContainer");

                container.style.visibility = "visible";
                container.style.opacity = "1";

                createHeart();

            }, 1000);
        }


        function createHeart() {

            const heart = document.getElementById("heart");

            const total = 300;

            for (let i = 0; i < total; i++) {

                const t = Math.PI * 2 * i / total;

                /*
                    Parametric heart equation
                */

                const x =
                    16 * Math.pow(Math.sin(t), 3);

                const y =
                    13 * Math.cos(t)
                    - 5 * Math.cos(2 * t)
                    - 2 * Math.cos(3 * t)
                    - Math.cos(4 * t);


                // Scale heart
                const scale = 15;

                const posX =
                    250 + x * scale;

                const posY =
                    220 - y * scale;


                const text =
                    document.createElement("span");

                text.classList.add("love");

                text.innerText = "I love you";


                text.style.left = posX + "px";
                text.style.top = posY + "px";


                // Random animation delay
                text.style.animationDelay =
                    (i * 0.015) + "s";


                heart.appendChild(text);
            }
        }

    </script>

</body>
</html>
